* text=auto
*.js text eol=lf
*.cjs text eol=lf
*.mjs text eol=lf
*.json text eol=lf
*.sfproj text eol=lf
*.md text eol=lf
*.html text eol=lf
*.css text eol=lf
*.cmd text eol=crlf
*.ps1 text eol=crlf
*.iss text eol=crlf
*.png binary
*.gif binary
*.ico binary
# Unified diffs include single-space context lines and original indentation.
integrations/alice/**/*.patch text eol=lf -whitespace
# The generated Illustrator converter includes literal spaces in PDF records.
src/native/gigma/illustrator.cjs text eol=lf -whitespace linguist-generated=true
src/gigma/editor.js text eol=lf linguist-generated=true
src/gigma/editor.css text eol=lf linguist-generated=true
