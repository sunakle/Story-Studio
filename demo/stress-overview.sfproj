      "type": "line",
      "chapterId": "ch_01",
      "title": "1.6",
      "speakerId": "c_echo",
      "locationId": "l_server",
      "text": "Нина оставляет записку под клавиатурой — если успеет.",
      "emotion": "сухо",
      "next": "n_8",
      "choices": [],
      "branches": [],
      "effects": [],
      "tags": [
