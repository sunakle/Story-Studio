+func TestDictationRepeatedTextBelongsToItsOwnWindow(t *testing.T) {
+	d, starts := newDictTest()
+	d.onEvent(logEvent{kind: "phrase", phrase: "Открой StoryForge"})
+	confirmDict(t, d, dictStart, "ok")
+	f := func(line string) {
+		t.Helper()
+		ev, ok := parseLine(line)
+		if !ok {
+			t.Fatalf("unrecognized test log: %s", line)
+		}
+		d.onEvent(ev)
+	}
+	listen := func(line string) {
+		t.Helper()
+		d.tickDictation(time.Now().Add(time.Millisecond))
+		select {
+		case ok := <-starts:
+			if !ok {
+				t.Fatal("current listen rejected")
+			}
+		case <-time.After(time.Second):
+			t.Fatal("missing listen after accepted phrase")
+		}
+		f(line)
+	}
+	const firstWindow = "[2026-11-25 09:00:01.000] onAliceStateChanged: LISTENING"
+	const firstFinal = "[2026-11-25 09:00:02.000] onRequestStateChanged: LISTENING, recognizedPhrase='Да.'"
+	listen(firstWindow)
+	f("[2026-11-25 09:00:01.001] onRequestStateChanged: LISTENING, recognizedPhrase=''")
+	f(firstFinal)
+	confirmDict(t, d, dictAppend, "ok")
+	for i := 0; i < 20; i++ {
+		f(firstWindow)
+		f(firstFinal)
+	}
+	d.tickDictation(time.Now().Add(time.Millisecond))
+	if !d.dictation.listenRequested.IsZero() {
+		t.Fatal("editor acknowledgement reopened the previous dialog before its IDLE")
+	}
+	f("[2026-11-25 09:00:02.100] onAliceStateChanged: IDLE")
+	listen("[2026-11-25 09:00:03.000] onAliceStateChanged: LISTENING")
+	for i := 0; i < 20; i++ {
+		f(firstWindow)
+		f(firstFinal)
+	}
+	if d.pcPending != nil {
+		t.Fatal("previous dialog replay became a new append")
+	}
+	f("[2026-11-25 09:00:04.100] onAliceStateChanged: IDLE")
+	f("[2026-11-25 09:00:04.101] onRequestStateChanged: LISTENING, recognizedPhrase='Да.'")
+	if c := confirmDict(t, d, dictAppend, "ok"); c.Seq != 2 || c.Query != "Да." {
+		t.Fatal("a deliberate repeat in the next dialog was lost")
+	}
+	listen("[2026-11-25 09:00:05.000] onAliceStateChanged: LISTENING")
+	f("[2026-11-25 09:00:06.000] onRequestStateChanged: LISTENING, recognizedPhrase='Стоп, диктовка'")
+	confirmDict(t, d, dictStop, "ok")
+	f(firstFinal)
+	if d.dictation != nil || d.pcPending != nil {
+		t.Fatal("stopped dictation restarted")
+	}
+}
