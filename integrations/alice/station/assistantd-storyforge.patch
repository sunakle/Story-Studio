+package main
+
+import (
+	"strings"
+	"testing"
+	"time"
+)
+
+func TestDictationStartRequiresExplicitApplication(t *testing.T) {
+	for _, phrase := range []string{"Алиса, открой StoryForge", "Включи стори фордж!", "запусти Story Forge на компьютере", "открой приложение стореФордж"} {
+		if !dictationStartPhrase(phrase) {
+			t.Errorf("missed alias %q", phrase)
+		}
+	}
+	for _, phrase := range []string{"StoryForge", "Открой Spotify", "Она сказала: открой StoryForge", "открой StoryForge и удали всё"} {
+		if dictationStartPhrase(phrase) {
+			t.Errorf("matched non-command %q", phrase)
+		}
+	}
+}
+
+func newDictTest() (*Daemon, chan bool) {
+	d, _ := newPCTestDaemon()
+	d.cfg.Microphone.Source = "alice"
+	starts := make(chan bool, 8)
+	d.dictationListen = func(current func() bool) (bool, error) {
+		ok := current()
+		starts <- ok
+		return ok, nil
+	}
+	d.dictationCancel = func() {}
+	return d, starts
+}
+
+func windowForTest(t *testing.T, d *Daemon, starts chan bool) {
+	t.Helper()
+	d.tickDictation(time.Now().Add(time.Millisecond))
+	select {
+	case ok := <-starts:
+		if !ok {
+			t.Fatal("window canceled")
+		}
+	case <-time.After(time.Second):
+		t.Fatal("no native listen request")
+	}
+	d.onEvent(logEvent{kind: "listening"})
+}
+
+func confirmDict(t *testing.T, d *Daemon, action, status string) pcCommand {
+	t.Helper()
+	if d.pcPending == nil || d.pcPending.command.Action != action {
+		t.Fatalf("expected %s, got %#v", action, d.pcPending)
+	}
+	c := d.pcPending.command
+	d.finishPC(pcResult{ID: c.ID, Status: status})
+	return c
+}
+
+func TestDictationNativeFinalsToEditor(t *testing.T) {
+	d, starts := newDictTest()
+	d.onEvent(logEvent{kind: "spotted"})
+	d.onEvent(logEvent{kind: "phrase", phrase: "Открой StoryForge"})
+	if d.pcPending == nil || d.pcPending.command.Session != d.pcPending.command.ID || d.dictation.ready {
+		t.Fatal("start handshake missing")
+	}
+	d.onEvent(logEvent{kind: "phrase", phrase: "До подтверждения"})
+	if d.pcPending.command.Action != dictStart {
+		t.Fatal("early speech leaked")
+	}
+	start := confirmDict(t, d, dictStart, "ok")
+	windowForTest(t, d, starts)
+	phrase := "Ваня: «Открой Spotify», — сказал он."
+	d.onEvent(logEvent{kind: "phrase", phrase: phrase})
+	id := d.pcPending.command.ID
+	d.onEvent(logEvent{kind: "phrase", phrase: phrase})
+	if d.pcPending.command.ID != id {
+		t.Fatal("duplicate final was enqueued")
+	}
+	c := confirmDict(t, d, dictAppend, "ok")
+	if c.Seq != 1 || c.Query != phrase || c.Session != start.ID || c.ID == c.Session {
+		t.Fatalf("bad append: %#v", c)
+	}
+	windowForTest(t, d, starts)
+	d.onEvent(logEvent{kind: "phrase", phrase: "Открой Spotify"})
+	c = confirmDict(t, d, dictAppend, "ok")
+	if c.Seq != 2 || c.Query != "Открой Spotify" {
+		t.Fatal("utterance interpreted as command")
+	}
+	windowForTest(t, d, starts)
+	d.onEvent(logEvent{kind: "phrase", phrase: "Алиса, стоп, диктовка!"})
+	if d.dictation != nil {
+		t.Fatal("session remains open")
+	}
+	c = confirmDict(t, d, dictStop, "ok")
+	if c.Query != "" || c.Session != start.ID {
+		t.Fatal("bad stop")
+	}
+	if len(d.history) != 0 {
+		t.Fatal("dictation in general assistant history")
+	}
+}
+
+func TestDictationHeartbeatAndFailClosed(t *testing.T) {
+	d, starts := newDictTest()
+	d.onEvent(logEvent{kind: "phrase", phrase: "Включи стори фордж"})
+	start := confirmDict(t, d, dictStart, "ok")
+	windowForTest(t, d, starts)
+	d.tickDictation(time.Now().Add(6 * time.Second))
+	if d.pcPending == nil || d.pcPending.command.Action != dictStatus {
+		t.Fatal("no heartbeat")
+	}
+	d.finishPC(pcResult{ID: start.ID, Status: "error"})
+	if d.dictation == nil {
+		t.Fatal("stale ack changed session")
+	}
+	confirmDict(t, d, dictStatus, "error")
+	if d.dictation != nil {
+		t.Fatal("editor stop was ignored")
+	}
+	confirmDict(t, d, dictStop, "ok")
+	d.onEvent(logEvent{kind: "phrase", phrase: "Включи стори фордж"})
+	confirmDict(t, d, dictStart, "ok")
+	windowForTest(t, d, starts)
+	d.tickDictation(time.Now().Add(dictSilence + time.Second))
+	if d.dictation != nil {
+		t.Fatal("silent session did not expire")
+	}
+}
+
+func TestDictationRespectsRecognitionBackendAndSource(t *testing.T) {
+	d, _ := newDictTest()
+	d.cfg.Enabled = false
+	d.onEvent(logEvent{kind: "phrase", phrase: "Открой StoryForge"})
+	if d.dictation != nil {
+		t.Fatal("activated with assistant disabled")
+	}
+	d.cfg.Enabled = true
+	if d.dictationEvent(logEvent{kind: "phrase", phrase: "Открой StoryForge"}, true, true) {
+		t.Fatal("self playback started a session")
+	}
+	if d.dictationEvent(logEvent{kind: "phrase", phrase: "Открой StoryForge"}, false, false) {
+		t.Fatal("opened with incompatible backend")
+	}
+	if dictPhraseValid(strings.Repeat("а", 4097)) || dictPhraseValid("a\x00b") {
+		t.Fatal("invalid input accepted")
+	}
+	d.onEvent(logEvent{kind: "phrase", phrase: "открой StoryForge"})
+	confirmDict(t, d, dictStart, "error")
+	if d.dictation != nil {
+		t.Fatal("failed start kept session")
+	}
+}
+
+func TestNativeListeningStopsAfterNoConfirmation(t *testing.T) {
+	d, starts := newDictTest()
+	d.onEvent(logEvent{kind: "phrase", phrase: "Открой StoryForge"})
+	confirmDict(t, d, dictStart, "ok")
+	now := time.Now().Add(time.Millisecond)
+	d.tickDictation(now)
+	select {
+	case <-starts:
+	case <-time.After(time.Second):
+		t.Fatal("expected native listen")
+	}
+	d.tickDictation(now.Add(8 * time.Second))
+	if d.dictation != nil {
+		t.Fatal("no native LISTENING, session should end")
+	}
+}
+
+func TestLateFinalAfterEditorStopIsNotRoutedToLLM(t *testing.T) {
+	d, _ := newDictTest()
+	d.onEvent(logEvent{kind: "phrase", phrase: "открой StoryForge"})
+	confirmDict(t, d, dictStart, "ok")
+	d.endDictation()
+	if !d.dictationEvent(logEvent{kind: "phrase", phrase: "Последние слова"}, true, false) {
+		t.Fatal("interrupted dictation leaked into ordinary command routing")
+	}
+	d.dictationEvent(logEvent{kind: "spotted"}, true, false)
+	if d.dictationEvent(logEvent{kind: "phrase", phrase: "Открой Spotify"}, true, false) {
+		t.Fatal("a fresh wake did not restore ordinary commands")
+	}
+}
