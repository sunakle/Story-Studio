+package main
+
+import (
+	"crypto/rand"
+	"encoding/hex"
+	"strings"
+	"time"
+	"unicode"
+	"unicode/utf8"
+)
+
+// Dictation uses only Alice's normal recognized-phrase events. A live editor has to
+// acknowledge the session before the station starts its first listening window.
+type dictationSession struct {
+	id                           string
+	nextSeq                      int
+	ready                        bool
+	lastText, lastContact        time.Time
+	listenAfter, listenRequested time.Time
+	listening                    bool
+}
+
+const (
+	dictStart     = "storyforge_start"
+	dictAppend    = "storyforge_append"
+	dictStop      = "storyforge_stop"
+	dictStatus    = "storyforge_status"
+	dictSilence   = 90 * time.Second
+	dictHeartbeat = 4 * time.Second
+)
+
+func dictationStartPhrase(s string) bool {
+	s = strings.TrimPrefix(normalize(s), "алиса ")
+	match := pcKnownProgramPattern.FindStringSubmatch(s)
+	if len(match) != 2 {
+		return false
+	}
+	switch normalize(match[1]) {
+	case "storyforge", "story forge", "сторифордж", "стори фордж", "стори форж", "сторифорж", "сторефордж", "стори фортж":
+		return true
+	}
+	return false
+}
+
+func dictationStopPhrase(s string) bool {
+	s = strings.TrimPrefix(normalize(s), "алиса ")
+	switch s {
+	case "стоп диктовка", "стоп диктовку", "останови диктовку", "закончи диктовку", "закончить диктовку", "заверши диктовку", "остановить диктовку":
+		return true
+	}
+	return false
+}
+
+func dictPhraseValid(s string) bool {
+	return strings.TrimSpace(s) != "" && utf8.ValidString(s) &&
+		utf8.RuneCountInString(s) <= 4096 && strings.IndexFunc(s, unicode.IsControl) < 0
+}
+
+func newDictID() string {
+	var id [16]byte
+	if _, err := rand.Read(id[:]); err != nil {
+		return ""
+	}
+	return hex.EncodeToString(id[:])
+}
+
+func (d *Daemon) queueDictLocked(action string, seq int, phrase string, now time.Time) bool {
+	session := d.dictation
+	if session == nil {
+		return false
+	}
+	id := session.id
+	if action != dictStart {
+		id = newDictID()
+	}
+	if id == "" {
+		return false
+	}
+	lease := 12 * time.Second
+	if action == dictStart {
+		lease = 40 * time.Second
+	}
+	d.pcPending = &pcPending{command: pcCommand{
+		ID: id, Action: action, Target: "storyforge", Session: session.id, Seq: seq, Query: phrase, CreatedAt: now.Unix(),
+	}, turn: d.turn, expires: now.Add(lease)}
+	d.dirty = true
+	return true
+}
+
+// Invalidate the local session first. In-flight replies from its previous ID
+// cannot arm the microphone or route a phrase into a different document.
+func (d *Daemon) endDictLocked(now time.Time) {
+	if d.dictation == nil {
+		return
+	}
+	d.queueDictLocked(dictStop, 0, "", now)
+	d.dictation = nil
+	d.dictationDrainUntil = now.Add(3 * time.Second)
+}
+
+func (d *Daemon) endDictation() {
+	d.mu.Lock()
+	open := d.dictation != nil
+	d.endDictLocked(time.Now())
+	d.mu.Unlock()
+	if open {
+		d.dictCancel()
+	}
+}
+
+func (d *Daemon) dictCancel() {
+	if d.dictationCancel != nil {
+		d.dictationCancel()
+		return
+	}
+	d.alice.Cancel()
+}
+
+// Called before interpreting recognized speech as a PC command or an LLM request.
+func (d *Daemon) dictationEvent(ev logEvent, enabled, ownPlayback bool) bool {
+	now := time.Now()
+	d.mu.Lock()
+	session := d.dictation
+	if session == nil {
+		// The native service can deliver one last recognition after Cancel.
+		// Keep private dictated text out of normal assistant routing. A fresh
+		// physical/wake-word turn immediately restores ordinary commands.
+		if ev.kind == "spotted" {
+			d.dictationDrainUntil = time.Time{}
+		}
+		if now.Before(d.dictationDrainUntil) && ev.kind == "phrase" && !dictationStartPhrase(ev.phrase) {
+			d.mu.Unlock()
+			return true
+		}
+		if !enabled || ownPlayback || ev.kind != "phrase" || !dictationStartPhrase(ev.phrase) {
+			d.mu.Unlock()
+			return false
+		}
+		if d.pcPending != nil {
+			turn := d.turn
+			d.mu.Unlock()
+			d.dictCancel()
+			d.pcSay(turn, "Дождитесь ответа компьютера и снова откройте StoryForge.")
+			return true
+		}
+		id := newDictID()
+		if id == "" {
+			d.mu.Unlock()
+			return true
+		}
+		d.dictation = &dictationSession{id: id, nextSeq: 1, lastText: now}
+		if d.cancel != nil {
+			d.cancel()
+		}
+		d.turn++
+		d.state, d.err = "idle", ""
+		d.route, d.ours, d.wokeUser = false, false, true
+		d.pcNoFollowUntil = time.Time{}
+		d.queueDictLocked(dictStart, 0, "", now)
+		d.mu.Unlock()
+		d.dictCancel()
+		return true
+	}
+	if !enabled {
+		d.endDictLocked(now)
+		d.mu.Unlock()
+		d.dictCancel()
+		return true
+	}
+	switch ev.kind {
+	case "listening":
+		if !session.listenRequested.IsZero() {
+			session.listening = true
+		}
+		d.mu.Unlock()
+		return true
+	case "idle":
+		if session.listening {
+			// The native speech service closed an empty listening window.
+			session.listening = false
+			session.listenRequested = time.Time{}
+			session.listenAfter = now.Add(350 * time.Millisecond)
+		}
+		d.mu.Unlock()
+		return true
+	case "phrase":
+		if dictationStopPhrase(ev.phrase) {
+			d.endDictLocked(now)
+			d.mu.Unlock()
+			d.dictCancel()
+			return true
+		}
+		// A repeated recognition event for the previous native dialog is
+		// ignored until the new native LISTENING event.
+		if !session.ready || !session.listening || session.listenRequested.IsZero() {
+			d.mu.Unlock()
+			return true
+		}
+		text := strings.TrimSpace(ev.phrase)
+		session.listening = false
+		session.listenRequested, session.listenAfter = time.Time{}, time.Time{}
+		if !dictPhraseValid(text) || !d.queueDictLocked(dictAppend, session.nextSeq, text, now) {
+			d.endDictLocked(now)
+		} else {
+			session.lastText = now
+		}
+		d.mu.Unlock()
+		d.dictCancel()
+		return true
+	case "spotted", "speaking":
+		d.mu.Unlock()
+		return true
+	default:
+		d.mu.Unlock()
+		return false
+	}
+}
+
+func (d *Daemon) tickDictation(now time.Time) {
+	d.mu.Lock()
+	s := d.dictation
+	if s == nil {
+		d.mu.Unlock()
+		return
+	}
+	if !d.cfg.Enabled || d.cfg.Microphone.Source != "alice" || now.Sub(s.lastText) >= dictSilence ||
+		(!s.listenRequested.IsZero() && !s.listening && now.Sub(s.listenRequested) > 7*time.Second) {
+		d.endDictLocked(now)
+		d.mu.Unlock()
+		d.dictCancel()
+		return
+	}
+	if s.ready && d.pcPending == nil && now.Sub(s.lastContact) >= dictHeartbeat {
+		d.queueDictLocked(dictStatus, 0, "", now)
+	}
+	if !s.ready || s.listenAfter.IsZero() || now.Before(s.listenAfter) {
+		d.mu.Unlock()
+		return
+	}
+	s.listenAfter = time.Time{}
+	s.listenRequested = now
+	d.mu.Unlock()
+	// Use the same native dialog as a user pressing the assistant button.
+	// Do not bypass the device mute switch or use an audio-capture backend.
+	current := func() bool {
+		d.mu.Lock()
+		defer d.mu.Unlock()
+		return d.dictation == s && s.listenRequested == now && !s.listening
+	}
+	go func() {
+		start := d.dictationListen
+		if start == nil {
+			start = d.alice.sendButton
+		}
+		_, err := start(current)
+		if err != nil {
+			d.mu.Lock()
+			if d.dictation == s && s.listenRequested == now {
+				d.endDictLocked(time.Now())
+			}
+			d.mu.Unlock()
+		}
+	}()
+}
+
+// d.mu is locked by the caller. A poll can overlap an utterance; its stale
+// acknowledgement is already excluded by the unique command ID in finishPC.
+func (d *Daemon) dictationAckLocked(command pcCommand, ok bool, now time.Time) bool {
+	if command.Target != "storyforge" {
+		return false
+	}
+	s := d.dictation
+	if s == nil || s.id != command.Session {
+		return false
+	}
+	if !ok {
+		d.endDictLocked(now)
+		return true
+	}
+	s.lastContact = now
+	switch command.Action {
+	case dictStart:
+		s.ready = true
+		s.lastText, s.listenAfter = now, now
+	case dictAppend:
+		s.nextSeq++
+		s.listenAfter = now
+	}
+	return false
+}
