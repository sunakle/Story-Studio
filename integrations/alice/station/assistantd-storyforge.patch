+package main
+
+import (
+	"strings"
+	"testing"
+	"time"
+)
+
+func TestDictationTopButtonPreservesPendingAppendAndConsumesClick(t *testing.T) {
+	d, starts := newDictTest()
+	d.onEvent(logEvent{kind: "phrase", phrase: "Алиса, открой StoryForge"})
+	start := confirmDict(t, d, dictStart, "ok")
+	windowForTest(t, d, starts)
+	d.onEvent(logEvent{kind: "phrase", phrase: "Последняя фраза."})
+	pending := d.pcPending.command
+	now := time.Now()
+	wakes := make(chan bool, 3)
+	d.buttonStart = func() error { wakes <- true; return nil }
+	d.buttonStop = func() { wakes <- true }
+	d.buttonCheck = func() bool { return true }
+	d.onEvent(logEvent{kind: "button_click", at: now})
+	// All correlated native follow-up events from this single click arrive
+	// in the normal event stream even though the session took ownership of it.
+	d.onEvent(logEvent{kind: "button_toggle", at: now.Add(time.Millisecond)})
+	d.onEvent(logEvent{kind: "button_no_player", at: now.Add(2 * time.Millisecond)})
+	d.onEvent(logEvent{kind: "button_stop_conversation", at: now.Add(3 * time.Millisecond)})
+	d.onEvent(logEvent{kind: "button_stop_alarm", at: now.Add(4 * time.Millisecond)})
+	d.onEvent(logEvent{kind: "phrase", phrase: "Дубль."})
+	d.tickDictation(now.Add(2 * time.Second))
+	if d.pcPending == nil || d.pcPending.command != pending || pending.Seq != 1 || pending.Query != "Последняя фраза." {
+		t.Fatal("press or trailing event lost or replaced the outstanding append")
+	}
+	if stop := confirmDictAfterAppend(t, d); stop.Session != start.Session {
+		t.Fatal("wrong session was stopped")
+	}
+	d.onEvent(logEvent{kind: "idle"})
+	d.tickDictation(now.Add(time.Minute))
+	select {
+	case <-wakes:
+		t.Fatal("the same press started an ordinary assistant turn")
+	case <-starts:
+		t.Fatal("stopped dictation was rearmed")
+	case <-time.After(120 * time.Millisecond):
+	}
+}
