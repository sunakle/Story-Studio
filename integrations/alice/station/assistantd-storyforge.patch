+package main
+
+import (
+	"crypto/rand"
+	"encoding/hex"
+	"strings"
+	"time"
+	"unicode"
+	"unicode/utf8"
+)
+
+// Dictation uses only Alice's normal recognized-phrase events. A live editor has to
+// acknowledge the session before the station starts its first listening window.
+type dictationSession struct {
+	id                           string
+	nextSeq                      int
+	ready                        bool
+	lastText, lastContact        time.Time
+	listenAfter, listenRequested time.Time
+	listening                    bool
+	stopping                     bool
+	// receipt times bound missing IDLE and a final delivered just after IDLE.
+	waitIdleFrom, finalUntil time.Time
+	// Device log time is only compared to other events from the same log.
+	boundaryAt, closedAt time.Time
+}
+
+const (
+	dictStart         = "storyforge_start"
+	dictAppend        = "storyforge_append"
+	dictStop          = "storyforge_stop"
+	dictStatus        = "storyforge_status"
+	dictSilence       = 90 * time.Second
+	dictHeartbeat     = 4 * time.Second
+	dictWindowTimeout = 7 * time.Second
+	dictFinalGrace    = 750 * time.Millisecond
+)
+
+func dictationStartPhrase(s string) bool {
+	s = strings.TrimPrefix(normalize(s), "алиса ")
+	match := pcKnownProgramPattern.FindStringSubmatch(s)
+	if len(match) != 2 {
+		return false
+	}
+	switch normalize(match[1]) {
+	case "storyforge", "story forge", "сторифордж", "стори фордж", "стори форж", "сторифорж", "сторефордж", "стори фортж":
+		return true
+	}
+	return false
+}
+
+func dictationStopPhrase(s string) bool {
+	s = strings.TrimPrefix(normalize(s), "алиса ")
+	switch s {
+	case "стоп диктовка", "стоп диктовку", "останови диктовку", "закончи диктовку", "закончить диктовку", "заверши диктовку", "остановить диктовку":
+		return true
+	}
+	return false
+}
+
+func dictPhraseValid(s string) bool {
+	return strings.TrimSpace(s) != "" && utf8.ValidString(s) &&
+		utf8.RuneCountInString(s) <= 4096 && strings.IndexFunc(s, unicode.IsControl) < 0
+}
+
+func newDictID() string {
+	var id [16]byte
+	if _, err := rand.Read(id[:]); err != nil {
+		return ""
+	}
+	return hex.EncodeToString(id[:])
+}
+
+func (d *Daemon) queueDictLocked(action string, seq int, phrase string, now time.Time) bool {
+	session := d.dictation
+	if session == nil {
+		return false
+	}
+	id := session.id
+	if action != dictStart {
+		id = newDictID()
+	}
+	if id == "" {
+		return false
+	}
+	lease := 12 * time.Second
+	if action == dictStart {
+		lease = 40 * time.Second
+	}
+	d.pcPending = &pcPending{command: pcCommand{
+		ID: id, Action: action, Target: "storyforge", Session: session.id, Seq: seq, Query: phrase, CreatedAt: now.Unix(),
+	}, turn: d.turn, expires: now.Add(lease)}
+	d.dirty = true
+	return true
+}
+
+// Invalidate the local session first. In-flight replies from its previous ID
+// cannot arm the microphone or route a phrase into a different document.
+func (d *Daemon) endDictLocked(now time.Time) {
+	if d.dictation == nil {
+		return
+	}
+	d.queueDictLocked(dictStop, 0, "", now)
+	d.dictation = nil
+	d.dictationDrainUntil = now.Add(3 * time.Second)
+}
+
+func (d *Daemon) endDictation() {
+	d.mu.Lock()
+	cancelNative := d.dictation != nil && d.dictation.nativeOpen()
+	d.endDictLocked(time.Now())
+	d.mu.Unlock()
+	if cancelNative {
+		d.dictCancel()
+	}
+}
+
+// The press is terminal for this session, including an append already in transit.
+// Never hand the same press back to the ordinary play/pause-to-assistant shortcut.
+func (d *Daemon) stopDictationByButton() bool {
+	now := time.Now()
+	d.mu.Lock()
+	s := d.dictation
+	if s == nil {
+		d.mu.Unlock()
+		return false
+	}
+	d.buttonGeneration++
+	d.buttonClickAt, d.buttonClickSeen, d.buttonToggleAt = time.Time{}, time.Time{}, time.Time{}
+	if s.stopping {
+		d.mu.Unlock()
+		return true
+	}
+	cancelNative := s.nativeOpen()
+	// The recognizer may finalize the already-open utterance just after the
+	// hardware press. Grant its normal finalization grace once, with no rearm.
+	if s.listening {
+		s.finalUntil = now.Add(dictFinalGrace)
+	}
+	s.stopping, s.listening = true, false
+	s.listenRequested, s.listenAfter, s.waitIdleFrom = time.Time{}, time.Time{}, time.Time{}
+	if !d.pendingDictAppendLocked(s) && !now.Before(s.finalUntil) {
+		d.endDictLocked(now)
+	}
+	d.mu.Unlock()
+	if cancelNative {
+		d.dictCancel()
+	}
+	return true
+}
+
+func (d *Daemon) pendingDictAppendLocked(s *dictationSession) bool {
+	p := d.pcPending
+	return p != nil && p.command.Action == dictAppend && p.command.Session == s.id
+}
+
+func (s *dictationSession) nativeOpen() bool {
+	return !s.listenRequested.IsZero() && s.finalUntil.IsZero()
+}
+
+func (d *Daemon) dictCancel() {
+	if d.dictationCancel != nil {
+		d.dictationCancel()
+		return
+	}
+	d.alice.Cancel()
+}
+
+// Called before interpreting recognized speech as a PC command or an LLM request.
+func (d *Daemon) dictationEvent(ev logEvent, enabled, ownPlayback bool) bool {
+	now := time.Now()
+	d.mu.Lock()
+	session := d.dictation
+	if session == nil {
+		// The native service can deliver one last recognition after Cancel.
+		// Keep private dictated text out of normal assistant routing. A fresh
+		// physical/wake-word turn immediately restores ordinary commands.
+		if ev.kind == "spotted" {
+			d.dictationDrainUntil = time.Time{}
+		}
+		if now.Before(d.dictationDrainUntil) && ev.kind == "phrase" {
+			d.mu.Unlock()
+			return true
+		}
+		if !enabled || ownPlayback || ev.kind != "phrase" || !dictationStartPhrase(ev.phrase) {
+			d.mu.Unlock()
+			return false
+		}
+		if !ev.at.IsZero() {
+			if ev.at.Equal(d.dictationLastStartAt) {
+				d.mu.Unlock()
+				return true
+			}
+			d.dictationLastStartAt = ev.at
+		}
+		if d.pcPending != nil {
+			turn := d.turn
+			d.mu.Unlock()
+			d.dictCancel()
+			d.pcSay(turn, "Дождитесь ответа компьютера и снова откройте StoryForge.")
+			return true
+		}
+		id := newDictID()
+		if id == "" {
+			d.mu.Unlock()
+			return true
+		}
+		d.dictation = &dictationSession{id: id, nextSeq: 1, lastText: now, boundaryAt: ev.at}
+		if d.cancel != nil {
+			d.cancel()
+		}
+		d.turn++
+		d.state, d.err = "idle", ""
+		d.route, d.ours, d.wokeUser = false, false, true
+		d.pcNoFollowUntil = time.Time{}
+		d.queueDictLocked(dictStart, 0, "", now)
+		d.mu.Unlock()
+		d.dictCancel()
+		return true
+	}
+	if !enabled {
+		cancelNative := session.nativeOpen()
+		d.endDictLocked(now)
+		d.mu.Unlock()
+		if cancelNative {
+			d.dictCancel()
+		}
+		return true
+	}
+	if session.stopping {
+		switch ev.kind {
+		case "phrase", "listening", "idle", "spotted", "speaking":
+		default:
+			d.mu.Unlock()
+			return false
+		}
+		if ev.kind == "spotted" || (ev.kind == "listening" && !ev.at.IsZero() && ev.at.After(session.boundaryAt)) {
+			session.finalUntil = time.Time{}
+			if !d.pendingDictAppendLocked(session) {
+				d.endDictLocked(now)
+			}
+		}
+		// Keep the last append in the single-slot PC queue until its matching
+		// acknowledgement. A duplicate state or late final cannot replace it.
+		if ev.kind == "phrase" && now.Before(session.finalUntil) &&
+			(ev.at.IsZero() || !ev.at.Before(session.boundaryAt)) &&
+			!d.pendingDictAppendLocked(session) && !dictationStopPhrase(ev.phrase) {
+			text := strings.TrimSpace(ev.phrase)
+			if dictPhraseValid(text) {
+				session.finalUntil = time.Time{}
+				if !d.queueDictLocked(dictAppend, session.nextSeq, text, now) {
+					d.endDictLocked(now)
+				}
+			}
+		}
+		d.mu.Unlock()
+		return true
+	}
+	switch ev.kind {
+	case "listening":
+		if !session.listenRequested.IsZero() && !session.listening && session.finalUntil.IsZero() &&
+			(ev.at.IsZero() || ev.at.After(session.boundaryAt)) {
+			session.listening = true
+			if !ev.at.IsZero() {
+				session.boundaryAt = ev.at
+			}
+		}
+		d.mu.Unlock()
+		return true
+	case "idle":
+		if !ev.at.IsZero() && ev.at.Before(session.boundaryAt) {
+			d.mu.Unlock()
+			return true
+		}
+		if !session.waitIdleFrom.IsZero() {
+			session.waitIdleFrom = time.Time{}
+			if !ev.at.IsZero() {
+				session.boundaryAt = ev.at
+			}
+		} else if session.listening {
+			// One native window ends here. A late final may still complete it.
+			// Silence never opens another window or sends another native cancel.
+			session.listening = false
+			session.finalUntil = now.Add(dictFinalGrace)
+			session.closedAt = ev.at
+		}
+		d.mu.Unlock()
+		return true
+	case "phrase":
+		if !ev.at.IsZero() && ev.at.Before(session.boundaryAt) {
+			d.mu.Unlock()
+			return true
+		}
+		if dictationStopPhrase(ev.phrase) {
+			cancelNative := session.nativeOpen()
+			d.endDictLocked(now)
+			d.mu.Unlock()
+			if cancelNative {
+				d.dictCancel()
+			}
+			return true
+		}
+		// A repeated recognition event for the previous native dialog is
+		// ignored until the new native LISTENING event.
+		if !session.ready || session.listenRequested.IsZero() ||
+			(!session.listening && (session.finalUntil.IsZero() || !now.Before(session.finalUntil))) {
+			d.mu.Unlock()
+			return true
+		}
+		text := strings.TrimSpace(ev.phrase)
+		if text == "" {
+			d.mu.Unlock()
+			return true
+		}
+		cancelNative := session.listening
+		if cancelNative {
+			session.waitIdleFrom = now
+		}
+		session.listening = false
+		session.listenRequested, session.listenAfter, session.finalUntil = time.Time{}, time.Time{}, time.Time{}
+		if !ev.at.IsZero() {
+			session.boundaryAt = ev.at
+		}
+		if session.closedAt.After(session.boundaryAt) {
+			session.boundaryAt = session.closedAt
+		}
+		session.closedAt = time.Time{}
+		if !dictPhraseValid(text) || !d.queueDictLocked(dictAppend, session.nextSeq, text, now) {
+			d.endDictLocked(now)
+		} else {
+			session.lastText = now
+		}
+		d.mu.Unlock()
+		if cancelNative {
+			d.dictCancel()
+		}
+		return true
+	case "spotted", "speaking":
+		d.mu.Unlock()
+		return true
+	default:
+		d.mu.Unlock()
+		return false
+	}
+}
+
+func (d *Daemon) tickDictation(now time.Time) {
+	d.mu.Lock()
+	s := d.dictation
+	if s == nil {
+		d.mu.Unlock()
+		return
+	}
+	if s.stopping {
+		if !d.pendingDictAppendLocked(s) && !now.Before(s.finalUntil) {
+			d.endDictLocked(now)
+		}
+		d.mu.Unlock()
+		return
+	}
+	if (!s.finalUntil.IsZero() && !now.Before(s.finalUntil)) ||
+		(!s.waitIdleFrom.IsZero() && now.Sub(s.waitIdleFrom) >= dictWindowTimeout) {
+		d.endDictLocked(now)
+		d.mu.Unlock()
+		return
+	}
+	if !d.cfg.Enabled || d.cfg.Microphone.Source != "alice" || now.Sub(s.lastText) >= dictSilence ||
+		(!s.listenRequested.IsZero() && !s.listening && s.finalUntil.IsZero() && now.Sub(s.listenRequested) >= dictWindowTimeout) {
+		cancelNative := s.nativeOpen()
+		d.endDictLocked(now)
+		d.mu.Unlock()
+		if cancelNative {
+			d.dictCancel()
+		}
+		return
+	}
+	if s.ready && d.pcPending == nil && now.Sub(s.lastContact) >= dictHeartbeat {
+		d.queueDictLocked(dictStatus, 0, "", now)
+	}
+	if !s.ready || s.listenAfter.IsZero() || now.Before(s.listenAfter) || !s.waitIdleFrom.IsZero() {
+		d.mu.Unlock()
+		return
+	}
+	s.listenAfter = time.Time{}
+	s.listenRequested = now
+	d.mu.Unlock()
+	// Use the same native dialog as a user pressing the assistant button.
+	// Do not bypass the device mute switch or use an audio-capture backend.
+	current := func() bool {
+		d.mu.Lock()
+		defer d.mu.Unlock()
+		return d.dictation == s && s.listenRequested == now && s.nativeOpen() && !s.listening
+	}
+	go func() {
+		start := d.dictationListen
+		if start == nil {
+			start = d.alice.listenForDictation
+		}
+		_, err := start(current)
+		if err != nil {
+			d.mu.Lock()
+			if d.dictation == s && s.listenRequested == now {
+				d.endDictLocked(time.Now())
+			}
+			d.mu.Unlock()
+		}
+	}()
+}
+
+// d.mu is locked by the caller. A poll can overlap an utterance; its stale
+// acknowledgement is already excluded by the unique command ID in finishPC.
+func (d *Daemon) dictationAckLocked(command pcCommand, ok bool, now time.Time) bool {
+	if command.Target != "storyforge" {
+		return false
+	}
+	s := d.dictation
+	if s == nil || s.id != command.Session {
+		return false
+	}
+	if s.stopping {
+		if !ok || command.Action == dictAppend || !now.Before(s.finalUntil) {
+			d.endDictLocked(now)
+		}
+		return false
+	}
+	if !ok {
+		cancelNative := s.nativeOpen()
+		d.endDictLocked(now)
+		return cancelNative
+	}
+	s.lastContact = now
+	switch command.Action {
+	case dictStart:
+		s.ready = true
+		s.lastText, s.listenAfter = now, now
+	case dictAppend:
+		s.nextSeq++
+		s.listenAfter = now
+	}
+	return false
+}
