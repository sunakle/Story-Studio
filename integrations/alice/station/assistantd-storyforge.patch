+func TestDictationNativeFinalsToEditor(t *testing.T) {
+	d, starts := newDictTest()
+	d.onEvent(logEvent{kind: "spotted"})
+	d.onEvent(logEvent{kind: "phrase", phrase: "Открой StoryForge"})
+	if d.pcPending == nil || d.pcPending.command.Session != d.pcPending.command.ID || d.dictation.ready {
+		t.Fatal("start handshake missing")
+	}
+	d.onEvent(logEvent{kind: "phrase", phrase: "До подтверждения"})
+	if d.pcPending.command.Action != dictStart {
+		t.Fatal("early speech leaked")
+	}
+	start := confirmDict(t, d, dictStart, "ok")
+	windowForTest(t, d, starts)
+	phrase := "Ваня: «Открой Spotify», — сказал он."
+	d.onEvent(logEvent{kind: "phrase", phrase: phrase})
+	id := d.pcPending.command.ID
+	d.onEvent(logEvent{kind: "phrase", phrase: phrase})
+	if d.pcPending.command.ID != id {
+		t.Fatal("duplicate final was enqueued")
+	}
+	c := confirmDict(t, d, dictAppend, "ok")
+	if c.Seq != 1 || c.Query != phrase || c.Session != start.ID || c.ID == c.Session {
+		t.Fatalf("bad append: %#v", c)
+	}
+	d.onEvent(logEvent{kind: "idle"})
+	windowForTest(t, d, starts)
+	d.onEvent(logEvent{kind: "phrase", phrase: "Открой Spotify"})
+	c = confirmDict(t, d, dictAppend, "ok")
+	if c.Seq != 2 || c.Query != "Открой Spotify" {
+		t.Fatal("utterance interpreted as command")
+	}
+	d.onEvent(logEvent{kind: "idle"})
+	windowForTest(t, d, starts)
+	d.onEvent(logEvent{kind: "phrase", phrase: "Алиса, стоп, диктовка!"})
+	if d.dictation != nil {
+		t.Fatal("session remains open")
+	}
+	c = confirmDict(t, d, dictStop, "ok")
+	if c.Query != "" || c.Session != start.ID {
+		t.Fatal("bad stop")
+	}
+	if len(d.history) != 0 {
+		t.Fatal("dictation in general assistant history")
+	}
+}
