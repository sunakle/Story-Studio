+func TestDictationStopInvalidatesPendingNativeOpen(t *testing.T) {
+	d, _ := newDictTest()
+	entered, resume, sent := make(chan struct{}), make(chan struct{}), make(chan bool, 1)
+	d.dictationListen = func(current func() bool) (bool, error) {
+		close(entered)
+		<-resume
+		ok := current()
+		sent <- ok
+		return ok, nil
+	}
+	activation := logEvent{kind: "phrase", phrase: "Открой StoryForge", at: time.Now()}
+	d.onEvent(activation)
+	confirmDict(t, d, dictStart, "ok")
+	d.tickDictation(time.Now().Add(time.Millisecond))
+	select {
+	case <-entered:
+	case <-time.After(time.Second):
+		close(resume)
+		t.Fatal("native open was never requested")
+	}
+	d.onEvent(logEvent{kind: "phrase", phrase: "Стоп, диктовка"})
+	close(resume)
+	if <-sent {
+		t.Fatal("an interrupted native open went through")
+	}
+	confirmDict(t, d, dictStop, "ok")
+	d.onEvent(activation)
+	if d.dictation != nil {
+		t.Fatal("a late replay of the original activation reopened the session")
+	}
+	d.onEvent(logEvent{kind: "spotted"})
+	d.onEvent(activation)
+	if d.dictation != nil {
+		t.Fatal("replayed timestamp was accepted as a fresh activation")
+	}
+	activation.at = activation.at.Add(time.Second)
+	d.onEvent(activation)
+	confirmDict(t, d, dictStart, "ok")
+}
