+func newDictTest() (*Daemon, chan bool) {
+	d, _ := newPCTestDaemon()
+	d.cfg.Microphone.Source = "alice"
+	starts := make(chan bool, 8)
+	d.dictationListen = func(current func() bool) (bool, error) {
+		ok := current()
+		starts <- ok
+		return ok, nil
+	}
+	d.dictationCancel = func() {}
+	return d, starts
+}
