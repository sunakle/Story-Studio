{
  "name": "storyforge",
  "productName": "StoryForge",
  "version": "1.8.4",
  "description": "StoryForge — редактор сценария для игр: ветвящиеся диалоги, персонажи, локации, AI-ассистент, экспорт в Godot",
  "main": "main.js",
  "scripts": {
    "start": "electron . --user-data-dir=.userdata",
    "start:safe": "electron . --no-sandbox --user-data-dir=.userdata",
    "dev": "electron . --dev --user-data-dir=.userdata",
    "pack:win": "node tools/windows/build.mjs",
    "dist:win": "node tools/windows/build.mjs --installer",
    "verify": "node tools/verify.mjs",
    "test": "node tools/verify.mjs && node tools/_selftest-export.mjs && node --test tools/project-persistence.test.mjs tools/test-story-player.mjs tools/writer-audio-ai.test.mjs tools/voice-library.test.mjs tools/voice-roundtrip.test.mjs tools/screenplay.test.mjs tools/screenplay-ai.test.mjs tools/chat-images.test.mjs tools/writing-skills.test.mjs tools/ai-team.test.mjs tools/alice-dictation.test.mjs tools/ai-artwork.test.mjs tools/ai-native-providers.test.mjs tools/ai-workshop-tools.test.mjs tools/rpg-engine.test.mjs tools/rpg-ai.test.mjs",
    "selftest": "node tools/run-selftest.mjs",
    "test:screenplay-chat": "node tools/test-screenplay-chat.mjs",
    "acceptance": "node tools/acceptance.mjs",
    "mock": "node tools/mock-ai-server.mjs --port=8799",
    "test:rpg": "node tools/test-rpg-workspace.mjs",
    "test:rpg-chat": "node tools/test-rpg-assistant.mjs",
    "test:gigma": "node tools/test-gigma-workspace.mjs",
    "test:photo-drag": "node tools/test-gigma-photo-drag.mjs",
    "test:startup-window": "node tools/test-startup-window.mjs",
    "test:workshop-conflict": "node tools/test-workshop-conflict.mjs",
    "test:project-resume": "node tools/test-project-resume.mjs",
    "test:ai-studio": "node tools/test-ai-workspace.mjs",
    "test:ai-providers": "node tools/test-provider-bridge.mjs",
    "test:ai-autonomy": "node tools/test-autonomous-studio.mjs",
    "test:chat-photo": "node tools/test-chat-photo-canvas.mjs",
    "test:workshop-followup": "node tools/test-workshop-followup.mjs"
  },
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "electron": "^33.4.11",
    "playwright-core": "1.65.0",
    "resedit": "3.1.1"
  },
  "allowScripts": {
    "electron@33.4.11": true
  }
}
